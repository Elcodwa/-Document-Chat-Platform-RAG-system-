# ============================================================================
# Copy this file to ".env" (same folder) and fill in the two values marked
# REQUIRED below. Everything else has a sensible default for local use.
#
#   cp .env.example .env
#
# See README.md for the full step-by-step setup guide.
# ============================================================================

# --- REQUIRED: free Groq API key (powers the chat / Text-to-SQL brain) ---
# 1. Go to https://console.groq.com/keys (free, no credit card required)
# 2. Sign up / log in, click "Create API Key"
# 3. Paste it below
GROQ_API_KEY=

# Which Groq model to use. llama-3.3-70b-versatile is a good default -
# high quality and still free. See https://console.groq.com/docs/models
# for the current list if you want to try a different one.
GROQ_MODEL=llama-3.3-70b-versatile

# --- REQUIRED: two secrets, generate them with the commands below ---
#
# JWT_SECRET_KEY signs login tokens - any long random string works:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

#
# ENCRYPTION_KEY encrypts database passwords before they're stored - it
# MUST be generated with this exact command (a generic random string will
# NOT work here, it has to be a valid Fernet key):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Optional tuning (defaults are fine for local use) ---
SQL_MAX_ROWS=500
SQL_STATEMENT_TIMEOUT_SECONDS=10
MAX_UPLOAD_SIZE_MB=25
DEBUG=true
